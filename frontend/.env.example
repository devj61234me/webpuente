# Frontend settings. Vite only exposes variables that start with VITE_.
# These are baked into the site when you run "npm run build", so they are public: never put secrets here.

# Full address of the backend API, WITHOUT a trailing slash. Leave empty in local development (the dev server proxies /api).
# Production example: https://webpuente-api.onrender.com
VITE_API_URL=
