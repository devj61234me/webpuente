# ==========================================================================================
# WebPuente backend settings  (copy this file to ".env" for local work: never commit ".env")
# On a host (Render, Railway, ...) you do NOT upload a .env file: paste these names and values
# into the host's "Environment Variables" screen instead.
# Placeholders below (CHANGE_ME, example.com) must be replaced. No real secrets belong in this file.
# ==========================================================================================

# --- Required -----------------------------------------------------------------------------
# Secret used to sign login tokens and password-reset links. Make a long random one:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=CHANGE_ME

# Which settings file to use. Local: development. On a server: production.
DJANGO_SETTINGS_MODULE=core.settings.development

# --- Database (MySQL 8 / MariaDB 10.6+) -----------------------------------------------------
DB_NAME=webpuente
DB_USER=webpuente_user
DB_PASSWORD=CHANGE_ME
DB_HOST=127.0.0.1
DB_PORT=3306
# Managed MySQL (Aiven, Railway, TiDB, ...) usually requires an encrypted connection. Use ONE of:
#   DB_SSL=true                   -> trust the normal public certificate list
#   DB_SSL_CA_PEM=...             -> paste the host's CA certificate text (use \n for line breaks if one line is required)
#   DB_SSL_CA=/path/to/ca.pem     -> path to a certificate file (local machine / Docker)
DB_SSL=false
DB_SSL_CA_PEM=
DB_SSL_CA=

# --- Production only (the server refuses to start without these) ------------------------------
# Host name(s) of THIS backend, comma separated, no https://   e.g. webpuente-api.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1
# Full address(es) of the FRONTEND, comma separated, no trailing slash   e.g. https://webpuente.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Address of the frontend. Used for the link inside password-reset emails.
FRONTEND_URL=http://localhost:5173
# Same as CORS_ALLOWED_ORIGINS (needed only if you use the /admin/ site over https)
CSRF_TRUSTED_ORIGINS=
# Only change if you know why. Raise HSTS to 31536000 (one year) after HTTPS works everywhere.
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=3600
# Hide the admin site at a less guessable address, e.g. ADMIN_URL=manage-9f3k2/
ADMIN_URL=admin/

# --- Background work -------------------------------------------------------------------------
# thread = analysis runs inside the web process (works on free hosts; a run is lost if the server restarts mid-run and can simply be started again)
# worker = a separate process runs:  python manage.py run_worker   (needs a second service on your host)
# inline = runs during the request (tests / tiny projects only)
JOB_MODE=thread
JOB_STALE_MINUTES=30

# --- Email (password reset) ------------------------------------------------------------------
# Local default prints emails in the terminal. For real email use SMTP (Brevo, Mailgun, SendGrid, Gmail app password, ...)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=WebPuente <no-reply@example.com>
# For real SMTP set: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# --- Optional features (all OFF by default) -----------------------------------------------------
# Semantic ("meaning") matching through an OpenAI-compatible embeddings API. Costs money with most providers.
EMBEDDINGS_ENABLED=false
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=
EMBEDDINGS_MAX_PAGES=5000
# Let users fetch page titles from live public websites (server makes outbound requests; blocks private networks)
ENABLE_WEBSITE_FETCH=false

# --- Limits (defaults are sensible; lower them on small hosts) ---------------------------------------
MAX_UPLOAD_MB=5
MAX_IMPORT_ROWS=20000
MAX_URLS_PER_PROJECT=50000
MAX_PROJECTS_PER_USER=50
AUTH_RATE=20/min
IMPORT_RATE=60/hour
ANALYSIS_RATE=30/hour
EXPORT_RATE=60/hour
FETCH_RATE=10/hour

# --- Misc ------------------------------------------------------------------------------------------
ENABLE_API_DOCS=true
TIME_ZONE=UTC
LOG_LEVEL=INFO
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
